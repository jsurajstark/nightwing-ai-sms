# Logging (terminal shows LLM request/response). Use DEBUG for full model JSON.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LLM — switch anytime: set LLM_PROVIDER=ollama OR gemini (only this line)
# Keep both sections filled; unused provider settings are ignored.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=ollama
LLM_PROVIDER=gemini
# Local Ollama (no API key; needs `ollama serve` + `make ollama-pull`)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# Google AI Studio (API; key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=AIzaSyANHNR4qVhvvOgZ_1kNPqkGYuklYMu6KUQ
GEMINI_MODEL=gemini-2.0-flash

# LLM timeouts: first attempt 180s; up to 2 retries on timeout only (+30s each → 210s, 240s)
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=2
LLM_TIMEOUT_INCREMENT_S=30

# Future providers (uncomment when wired)
# ANTHROPIC_API_KEY=
# AWS_REGION=
# BEDROCK_MODEL_ID=

# Database
DATABASE_URL=sqlite:///./data/demo.db

# ---------------------------------------------------------------------------
# Extraction queue — demo: Celery + Redis | production: AWS SQS
# ---------------------------------------------------------------------------
# celery = Redis + make worker (recommended demo) | inline = no Redis | sqs = AWS
QUEUE_BACKEND=celery
REDIS_URL=redis://127.0.0.1:6379/0
# Optional overrides (default to REDIS_URL)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_QUEUE_NAME=sms_extraction

# Production (QUEUE_BACKEND=sqs, pip install -e ".[sqs]")
# AWS_REGION=us-east-1
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/nightwing-sms-extraction

# Twilio webhook (optional). When ENABLE_TWILIO_WEBHOOK=true, set token and public HTTPS base URL
# used to reconstruct the webhook URL for signature validation (e.g. ngrok URL, no trailing slash).
ENABLE_TWILIO_WEBHOOK=true
TWILIO_AUTH_TOKEN=2d219f62dd9def9573bc5f44792c0fe6
PUBLIC_BASE_URL=https://figurine-musky-postal.ngrok-free.dev
