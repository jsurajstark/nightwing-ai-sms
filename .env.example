# Logging (terminal shows LLM request/response). Use DEBUG for full model JSON.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LLM — set ONE active provider. All model IDs from .env only.
# LLM_PROVIDER=ollama | gemini | openrouter | github
LLM_PROVIDER=github

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# Google AI Studio
GOOGLE_API_KEY=
GEMINI_MODEL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BASE_S=5

# GitHub Models — https://docs.github.com/en/rest/models/inference
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_BASE_URL=https://models.github.ai
GITHUB_MODELS_MODEL=meta/meta-llama-3.1-8b-instruct
GITHUB_MODELS_API_VERSION=2026-03-10
# GITHUB_MODELS_ORG=
# GITHUB_MODELS_FALLBACK_MODELS=
GITHUB_MODELS_MAX_RETRIES=2
GITHUB_MODELS_RETRY_BASE_S=5

# LLM timeouts: first attempt 180s; up to 2 retries on timeout only (+30s each → 210s, 240s)
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=2
LLM_TIMEOUT_INCREMENT_S=30

# Future providers (uncomment when wired)
# ANTHROPIC_API_KEY=
# AWS_REGION=
# BEDROCK_MODEL_ID=

# Database
DATABASE_URL=sqlite:///./data/demo.db

# ---------------------------------------------------------------------------
# Nightwing Core — partial referral (POST /api/v1/partial-referral)
# ---------------------------------------------------------------------------
CORE_API_BASE_URL=https://api-stage.mynightwing.com
CORE_API_ACCESS_TOKEN=
# Optional (empty = no clientId on partial-referral POST)

CORE_PARTIAL_REFERRAL_ENABLED=true
CORE_API_TIMEOUT_S=30

# ---------------------------------------------------------------------------
# Extraction queue — demo: Celery + Redis | production: AWS SQS
# ---------------------------------------------------------------------------
# celery = Redis + make worker (recommended demo) | inline = no Redis | sqs = AWS
QUEUE_BACKEND=celery
REDIS_URL=redis://127.0.0.1:6379/0
# Optional overrides (default to REDIS_URL)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_QUEUE_NAME=sms_extraction

# Production (QUEUE_BACKEND=sqs, pip install -e ".[sqs]")
# AWS_REGION=us-east-1
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/nightwing-sms-extraction

# Twilio webhook (optional). When ENABLE_TWILIO_WEBHOOK=true, set token and public HTTPS base URL
# used to reconstruct the webhook URL for signature validation (e.g. ngrok URL, no trailing slash).
ENABLE_TWILIO_WEBHOOK=true
TWILIO_AUTH_TOKEN=2d219f62dd9def9573bc5f44792c0fe6
PUBLIC_BASE_URL=https://figurine-musky-postal.ngrok-free.dev
